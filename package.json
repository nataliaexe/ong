{
  "name": "floranimal-ong-pro",
  "version": "2.0.0",
  "description": "ONG de animais com tema floral - sistema nivel producao",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --config vite.config.js",
    "dev:backend": "set NODE_ENV=development&& nodemon --watch src/backend src/backend/server.js",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build --config vite.config.js",
    "build:backend": "esbuild src/backend/server.js --bundle --platform=node --outfile=dist/backend/server.js --external:express --external:cors --external:helmet --external:dotenv",
    "start": "set NODE_ENV=production&& node dist/backend/server.js",
    "test": "set NODE_ENV=test&& jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,scss,json,md}\"",
    "docker:build": "docker build -t floranimal-ong:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "security:audit": "npm audit --audit-level=high",
    "prepare": "husky install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^3.22.4",
    "joi": "^17.11.0",
    "express-validator": "^7.0.1",
    "compression": "^1.7.4",
    "express-async-errors": "^3.1.1",
    "uuid": "^9.0.1",
    "node-cache": "^5.1.2",
    "axios": "^1.6.2",
    "nodemailer": "^6.9.7",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "vite": "^5.0.8",
    "sass": "^1.69.5",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.10",
    "jest": "^29.7.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "husky": "^8.0.3",
    "supertest": "^6.3.3",
    "@types/node": "^20.10.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint && npm run format",
      "pre-push": "npm run test"
    }
  }
}
